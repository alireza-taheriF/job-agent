# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_USER_ID=
# Optional proxy for Telegram, e.g. http://127.0.0.1:1080 or socks5://127.0.0.1:1080
TELEGRAM_PROXY=

# Karlancer
KARLANCER_EMAIL=

# LLM backend: "claude_cli" (default, uses installed Claude Code CLI)
#          or "anthropic_api" (requires ANTHROPIC_API_KEY below)
LLM_BACKEND=claude_cli
ANTHROPIC_API_KEY=
CLAUDE_MODEL=

# Database path (relative to project root)
DB_PATH=data/jobs.db

# LLM rate limits (tune to protect your subscription)
LLM_MAX_CONCURRENT=2
LLM_MAX_PER_MINUTE=8
LLM_TIMEOUT=90

# Email — application emails and cold outreach (Gmail: needs an App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Reply detection for cold outreach
IMAP_HOST=imap.gmail.com
